# =============================================================================
# Anker Relocation — pipeline configuration
# Every variable is optional. Missing keys → the pipeline falls back to a safe
# demo behaviour (mock qualifier / CSV storage / stdout notifications).
# =============================================================================

# --- HTTP ---------------------------------------------------------------------
# Port the Go service listens on. The landing image proxies /api/ here.
PIPELINE_PORT=8081
# Origins allowed to POST /api/leads. Comma-separated. Use * only for a local
# throwaway experiment; a deployed site must list its exact public origin.
CORS_ORIGINS=http://localhost:8080
# Trust X-Real-IP only when the direct peer is this reverse proxy network.
# Keep empty for direct local development.
TRUSTED_PROXY_CIDRS=
# Prometheus pulls GET /metrics on the pipeline port. Keep that port bound to
# localhost or a private network; it is not proxied by the public landing.

# --- Telegram (lead intake bot + manager notifications) -----------------------
# Single bot token used for both roles.
TELEGRAM_BOT_TOKEN=
# Chat id (group or user) where new-lead cards are posted. Prefix with -100 for
# supergroups. Get it by adding @RawDataBot to your group.
TELEGRAM_MANAGER_CHAT_ID=
# Public username used by the landing "message us on Telegram" button.
TELEGRAM_BOT_USERNAME=anker_relocation_bot

# --- OpenRouter (AI qualification) --------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_TIMEOUT_SECONDS=15

# --- HubSpot (CRM primary) ----------------------------------------------------
# Private-app token with contacts + deals scopes.
HUBSPOT_TOKEN=
# Optional pipeline id; if empty, uses the account default sales pipeline.
HUBSPOT_PIPELINE_ID=

# --- Google Sheets (CRM fallback) --------------------------------------------
SHEETS_SPREADSHEET_ID=
# Leave empty in demo mode. For Docker, use docker-compose.sheets.yml to mount
# the service-account JSON read-only at /run/secrets/sheets_sa.json.
SHEETS_SA_JSON=
SHEETS_TAB=Leads

# --- SMTP (customer auto-reply) -----------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Anker Relocation <hello@anker-relocation.example>"

# --- Slack (optional notification adapter) ------------------------------------
SLACK_WEBHOOK_URL=
SLACK_SIGNING_SECRET=
